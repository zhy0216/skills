{
  "routes": [
    {
      "repo": "/absolute/path/to/repository",
      "team": "ENG",
      "project": "Project name or UUID",
      "todoState": "Todo",
      "inReviewState": "In Review"
    }
  ],
  "defaults": {
    "agent": "codex",
    "model": null,
    "reasoningEffort": "xhigh",
    "extraArgs": []
  },
  "agents": {
    "orchestrator": {
      "reasoningEffort": "high"
    },
    "planner": {
      "agent": "opencode",
      "model": null,
      "reasoningEffort": "high",
      "extraArgs": [
        "--agent",
        "build"
      ]
    },
    "executor": {},
    "creator": {
      "agent": "codex",
      "model": null,
      "reasoningEffort": "xhigh",
      "extraArgs": []
    }
  },
  "timeoutMinutes": 720,
  "maxActiveAgents": 8,
  "herdrBin": "herdr",
  "creation": {
    "schedule": "0 2 * * *"
  }
}
