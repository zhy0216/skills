{
  "routes": [
    {
      "repo": "/absolute/path/to/repository",
      "team": "EZT",
      "todoState": "Todo",
      "inProgressState": "In Progress",
      "inReviewState": "In Review"
    }
  ],
  "defaults": {
    "agent": "codex",
    "model": null,
    "reasoningEffort": "xhigh",
    "extraArgs": [
      "--ephemeral"
    ]
  },
  "agents": {
    "orchestrator": {
      "reasoningEffort": "medium"
    },
    "planner": {
      "reasoningEffort": "high"
    },
    "executor": {
      "reasoningEffort": "xhigh"
    },
    "creator": {
      "agent": "codex",
      "model": null,
      "reasoningEffort": "xhigh",
      "extraArgs": []
    }
  },
  "timeoutMinutes": 720,
  "maxActiveAgents": 8,
  "linearBin": "linear-cli",
  "herdrBin": "herdr",
  "codexBin": "codex",
  "creation": {
    "schedule": "0 2 * * *"
  }
}
