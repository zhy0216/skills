{
  "routes": [
    {
      "repo": "/absolute/path/to/repository",
      "team": "EZT",
      "todoState": "Todo",
      "inProgressState": "In Progress",
      "doneState": "Done"
    }
  ],
  "defaults": {
    "agent": "opencode",
    "model": null,
    "reasoningEffort": null,
    "extraArgs": [
      "--agent",
      "build"
    ]
  },
  "agents": {
    "orchestrator": {
      "extraArgs": [
        "--agent",
        "build",
        "--title",
        "Linear orchestrator"
      ]
    },
    "planner": {
      "extraArgs": [
        "--agent",
        "build",
        "--title",
        "Linear planner"
      ]
    },
    "executor": {
      "extraArgs": [
        "--agent",
        "build",
        "--title",
        "Linear executor"
      ]
    },
    "creator": {
      "agent": "opencode",
      "model": null,
      "reasoningEffort": null,
      "extraArgs": [
        "--agent",
        "build",
        "--title",
        "Linear creator"
      ]
    }
  },
  "timeoutMinutes": 720,
  "maxActiveAgents": 8,
  "linearBin": "linear-cli",
  "herdrBin": "herdr",
  "opencodeBin": "opencode",
  "creation": {
    "schedule": "0 2 * * *"
  }
}
